{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlucoFlowS3Objects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::glucoflow-bronze-lk-1/*",
        "arn:aws:s3:::glucoflow-silver-lk-2/*",
        "arn:aws:s3:::glucoflow-gold-lk-3/*",
        "arn:aws:s3:::glucoflow-quarantine-lk-4/*"
      ]
    },
    {
      "Sid": "GlucoFlowS3List",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::glucoflow-bronze-lk-1",
        "arn:aws:s3:::glucoflow-silver-lk-2",
        "arn:aws:s3:::glucoflow-gold-lk-3",
        "arn:aws:s3:::glucoflow-quarantine-lk-4"
      ]
    },
    {
      "Sid": "GlucoFlowAthena",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlucoFlowGlue",
      "Effect": "Allow",
      "Action": [
        "glue:CreateDatabase",
        "glue:GetDatabase",
        "glue:CreateTable",
        "glue:GetTable",
        "glue:UpdateTable"
      ],
      "Resource": "*"
    }
  ]
}
