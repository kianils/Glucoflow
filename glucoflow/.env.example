# AWS configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# S3 bucket names — must be globally unique; suffix with your initials + random string
# Example: glucoflow-bronze-jd-a3f9
BRONZE_BUCKET=glucoflow-bronze-lk-1
SILVER_BUCKET=glucoflow-silver-lk-2
GOLD_BUCKET=glucoflow-gold-lk-3
QUARANTINE_BUCKET=glucoflow-quarantine-lk-4
